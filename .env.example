# Copy this file to .env and fill in real values.
#
# Where to get each one:
#   OPENAI_API_KEY       -- https://platform.openai.com/api-keys
#   PRIVARO_API_KEY       -- Privaro dashboard -> Admin -> API Keys
#                            (format: prvr_ followed by hex characters,
#                            sent as X-Privaro-Key -- not a Bearer token)
#   PRIVARO_PIPELINE_ID   -- Privaro dashboard -> Pipelines -> click a
#                            pipeline -> copy its UUID

OPENAI_API_KEY=
PRIVARO_API_KEY=
PRIVARO_PIPELINE_ID=

# Optional -- only override if self-hosting Privaro or using a VPC
# deployment. Defaults to Privaro's production API.
# PRIVARO_BASE_URL=https://api.privaro.ai

# Optional -- defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
